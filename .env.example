# Document excerpts leave your computer only when using AI or DOI lookup.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RESEARCHVAULT_DATA=data
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=30
MAX_AI_CHUNKS=24

# Free local AI: set AI_PROVIDER=ollama, install Ollama, then pull both models.
AI_PROVIDER=openai
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_AI_CHUNKS=8
